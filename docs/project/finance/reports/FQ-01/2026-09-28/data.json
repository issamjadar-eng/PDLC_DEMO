 "verdicts": [
  {
   "id": "v-main",
   "headline": "H1 2026 gross margin 51.5% vs 50.6% H1 2025 (+1.0 pts) \u2014 BELOW the 55% floor; 2 of 6 lines eroding (GM down 1 pt or more YoY); eroding: PP3000 -1.5 pts, IP5000 -1.5 pts; standard-cost variance beyond \u00b15% on 0 of 6 lines (all revenue types); hardware-only variance beyond \u00b15% on 2 of 5 device lines \u2014 unfavorable PP3000 +11.0%, IP5000 +10.9%",
   "evidence_class": "derived"
  }
 ],
 "narrative": {
  "issues": [
   {
    "id": "I1",
    "severity": "medium",
    "statement": "PP3000 gross margin 44.9% in H1 2026 vs 46.4% in H1 2025 (-1.5 pts) while its hardware unit cost runs +11.0% above standard (line total +4.9%, diluted by consumables and service)",
    "action": "Cost review of the line: reset the standard to actual, then decide price action vs run-down at the quarterly margin review",
    "evidence": [
     "derived: gm-by-line",
     "derived: cost-variance-by-line",
     "src: commercial/internal-financials@2026-09-28",
     "src: finance/internal-standard-costs@2026-09-28",
     "config: finance.yml"
    ]
   },
   {
    "id": "I2",
    "severity": "medium",
    "statement": "IP5000 gross margin 45.6% in H1 2026 vs 47.1% in H1 2025 (-1.5 pts) while its hardware unit cost runs +10.9% above standard (line total +4.6%, diluted by consumables and service)",
    "action": "Cost review of the line: reset the standard to actual, then decide price action vs run-down at the quarterly margin review",
    "evidence": [
     "derived: gm-by-line",
     "derived: cost-variance-by-line",
     "src: commercial/internal-financials@2026-09-28",
     "src: finance/internal-standard-costs@2026-09-28",
     "config: finance.yml"
    ]
   }
  ],
  "risks": [
   {
    "id": "R1",
    "severity": "medium",
    "statement": "Company gross margin 51.5% sits below the 55% floor \u2014 the floor is a stand-in (no plan of record names one), so the miss is only as firm as an unratified target",
    "mitigation": "Have finance ratify a margin floor in the plan of record and mark E-01.1 validated",
    "evidence": [
     "derived: gm-stat",
     "config: finance.yml"
    ]
   },
   {
    "id": "R2",
    "severity": "medium",
    "statement": "Margin reporting on standards flatters IP5000, PP3000 \u2014 hardware unit cost runs above standard (PP3000 +11.0%, IP5000 +10.9%), so booked unit costs understate actual cost",
    "mitigation": "Standard reset at the next standards cycle; interim margin reporting on actual unit cost",
    "evidence": [
     "derived: cost-variance-by-line",
     "derived: cost-variance-trend",
     "src: commercial/internal-financials@2026-09-28",
     "src: finance/internal-standard-costs@2026-09-28"
    ]
   }
  ],
  "watch": [
   {
    "id": "W1",
    "statement": "Mix masking: company margin is up +1.0 pts YoY while 2 line(s) erode \u2014 the aggregate is lifted by mix, not by line health",
    "evidence": [
     "derived: gm-stat",
     "derived: gm-by-line"
    ]
   }
  ]
 },
