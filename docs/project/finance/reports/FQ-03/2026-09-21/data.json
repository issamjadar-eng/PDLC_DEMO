  "risks": [
   {
    "id": "R1",
    "severity": "medium",
    "statement": "Per-unit figures use the fleet registry as a point-in-time denominator for both windows \u2014 a fleet that grew over the year makes prior-year per-unit costs look lower than they were",
    "mitigation": "Pin a fleet snapshot per window once recurring fleet snapshots exist; until then read per-unit YoY as directional",
    "evidence": [
     "src: commercial/internal-fleet@2026-09-21",
     "derived: cost-per-unit-yoy"
    ]
   },
   {
    "id": "R2",
    "severity": "medium",
    "statement": "Replacements ($264K) outspend repairs ($65K) YTD 2026 (2026-01..2026-08) \u2014 cost per claim is being driven by the replace share",
    "mitigation": "Depot-repair capacity review for the lines driving replacements",
    "evidence": [
     "derived: disposition-mix",
     "src: finance/internal-warranty-claims@2026-09-21"
    ]
   }
  ],
  "watch": [
