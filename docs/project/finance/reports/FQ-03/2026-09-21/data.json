   },
   {
    "id": "I5",
    "severity": "medium",
    "statement": "PP3000 warranty cost per installed unit $801 YTD 2026 (2026-01..2026-08) vs $397 same months 2025 (+101.6%) \u2014 beyond the 10% tolerance",
    "action": "Re-test the warranty reserve for the line against the observed per-unit trend (FQ-04) and review end-of-life timing",
    "evidence": [
     "derived: cost-per-unit-yoy",
     "src: finance/internal-warranty-claims@2026-09-21",
