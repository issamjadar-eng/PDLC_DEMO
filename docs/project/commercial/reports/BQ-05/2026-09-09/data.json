 "verdicts": [
  {
   "id": "v-main",
   "headline": "$366.0M of the $1,000.0M five-year plan sits behind FDA decisions not yet received; exposure crosses the 40% threshold in FY2029, FY2030 (peak 60.0% in FY2030)",
   "evidence_class": "derived"
  }
 ],
 "narrative": {
  "issues": [
   {
    "id": "I1",
    "severity": "high",
    "statement": "FY2029 exposure is 42.9% \u2014 $105.0M of $245.0M sits behind pccp-enabled or new-submission decisions, over the 40% threshold",
    "action": "Require a formal contingency in the plan narrative for the year; tie each dependent revenue block to a named submission milestone so slips become trackable events",
    "evidence": [
     "derived: exposure-by-year",
     "src: commercial/internal-revenue-plan@2026-07-27",
     "config: commercial.yml"
    ]
   },
   {
    "id": "I2",
    "severity": "high",
    "statement": "FY2030 exposure is 60.0% \u2014 $210.0M of $350.0M sits behind pccp-enabled or new-submission decisions, over the 40% threshold",
    "action": "Require a formal contingency in the plan narrative for the year; tie each dependent revenue block to a named submission milestone so slips become trackable events",
    "evidence": [
     "derived: exposure-by-year",
     "src: commercial/internal-revenue-plan@2026-07-27",
     "config: commercial.yml"
    ]
   }
  ],
  "risks": [
   {
    "id": "R1",
    "severity": "medium",
    "statement": "A uniform 6-month slip of all dependent revenue cuts FY2030 by $52.5M and pushes $105.0M past FY2030 \u2014 out of the five-year window entirely",
    "mitigation": "The slip is arithmetic, not probability \u2014 pair it with the regulatory team's submission-timeline confidence before treating either scenario as the planning case",
    "evidence": [
     "derived: slip-scenarios",
     "src: commercial/internal-revenue-plan@2026-07-27",
     "config: commercial.yml"
    ]
   },
   {
    "id": "R2",
    "severity": "high",
    "statement": "A uniform 12-month slip of all dependent revenue cuts FY2030 by $105.0M and pushes $210.0M past FY2030 \u2014 out of the five-year window entirely",
    "mitigation": "The slip is arithmetic, not probability \u2014 pair it with the regulatory team's submission-timeline confidence before treating either scenario as the planning case",
    "evidence": [
     "derived: slip-scenarios",
     "src: commercial/internal-revenue-plan@2026-07-27",
     "config: commercial.yml"
    ]
   }
  ],
  "watch": [
   {
    "id": "W1",
    "statement": "Public base rate: median FRN 510(k) review runs 214.0 days received-to-decision across 30 clearances since 2021 \u2014 one review cycle (214.0 days) vs \u2248182 days for the smallest (6-month) slip scenario, and that measures cleared traditional/special 510(k)s, not PCCP or novel pathways",
    "evidence": [
     "derived: fda-review-stat",
     "src: commercial/openfda-510k-infusion@2026-09-09"
    ]
   },
