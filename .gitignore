# Google Drive for Desktop sync metadata — this project tree may live inside
# a Drive-synced folder; these are transient sync artifacts, not project files.
# Excel temporary files
~$*
.tmp.driveupload/
.tmp.drivedownload/
.driveupload
.drivedownload
desktop.ini
Icon?
*.gdoc
